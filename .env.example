# ORBITAL — environment
# Copy to .env.local for development, and set these in your host's dashboard
# for production. Nothing here is exposed to the browser except NEXT_PUBLIC_*.

# Canonical origin, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL="https://orbital.example.com"

# Address shown on the site (footer, contact page).
NEXT_PUBLIC_CONTACT_EMAIL="hello@orbital.systems"

# --- Contact form delivery (server-only) ---------------------------------
# With RESEND_API_KEY unset the API route logs the enquiry to the server log
# instead of emailing it, so a misconfigured deploy fails loudly rather than
# losing enquiries silently.
RESEND_API_KEY=""
CONTACT_INBOX="hello@orbital.systems"
CONTACT_FROM="ORBITAL <noreply@orbital.systems>"
