# Public identity: fill these with verified production values before launch.
NEXT_PUBLIC_SITE_URL="https://orbital.example.com"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_LINKEDIN_URL=""

# Server-only. All three are required to accept a real enquiry.
# Missing configuration returns an error; enquiry contents are never logged.
RESEND_API_KEY=""
CONTACT_INBOX=""
CONTACT_FROM=""

# Enable only on the HTTPS deployment, never on HTTP local previews.
ORBITAL_ENFORCE_HTTPS="false"
