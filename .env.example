NEXT_PUBLIC_SITE_URL=https://www.reachorbital.tech
# Set false on preview deployments; production is indexable by default.
SITE_INDEXABLE=true
# Production must use an absolute path on a persistent, private volume.
LEAD_STORAGE_DIR=D:/Orbital-Website/data/leads
LEAD_EMAIL_TO=operations@reachorbital.tech
LEAD_EMAIL_FROM=ORBITAL <website@reachorbital.tech>
RESEND_API_KEY=
# Protect the scheduled retry endpoint with a random secret.
CRON_SECRET=
