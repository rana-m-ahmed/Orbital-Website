# ORBITAL — environment
# Copy to .env.local for development and configure production values in the
# hosting platform. Only NEXT_PUBLIC_* variables are exposed to the browser.

# Canonical production origin used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL="https://reachorbital.tech"

# Public contact address rendered on the site.
# Replace this with the final @reachorbital.tech mailbox once the mailbox is live.
NEXT_PUBLIC_CONTACT_EMAIL="orbitalteamhq@gmail.com"

# --- Contact form delivery (server-only) ---------------------------------
# Development may run without Resend and will log enquiries locally.
# Production intentionally fails contact delivery when RESEND_API_KEY is absent
# so the UI can never claim a lead was delivered when it was only written to logs.
RESEND_API_KEY=""
CONTACT_INBOX=""
CONTACT_FROM=""
