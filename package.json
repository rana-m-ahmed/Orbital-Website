{
  "name": "orbital-flagship",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --conditions=react-server --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/postcss": "4.3.3",
    "gsap": "3.15.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "three": "^0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "sharp": "^0.35.4",
    "typescript": "6.0.3"
  }
}
